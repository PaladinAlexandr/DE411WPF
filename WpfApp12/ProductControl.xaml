<UserControl x:Class="WpfApp12.ProductControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfApp12"
             FontFamily="Times New Roman"
             FontSize="18" Background="White"
             mc:Ignorable="d" Height="203" Width="914" >
    <Border BorderBrush="Black" BorderThickness="2" >
        <Grid>
            <Border BorderBrush="Black" BorderThickness="2" Margin="10,10,655,10">
                <Image x:Name="PhotoProductImage" Source="/picture.png"/>
            </Border>
            <Border BorderBrush="Black" BorderThickness="1" Margin="262,10,117,10">
                <StackPanel>
                    <TextBlock x:Name="CategoryAndNameTextBlock" TextWrapping="Wrap" Text="TextBlock"/>
                    <TextBlock x:Name="DescriptionTextBlock" TextWrapping="Wrap" Text="TextBlock"/>
                    <TextBlock x:Name="ManufactureTextBlock" TextWrapping="Wrap" Text="TextBlock"/>
                    <TextBlock x:Name="SupplierTextBlock" TextWrapping="Wrap" Text="TextBlock"/>
                    <TextBlock>
                        <Run Name="OldPrice"></Run>
                        <Run Name="NewPrice"></Run>
                    </TextBlock>
                    <TextBlock x:Name="UnitMetricTextBlock" TextWrapping="Wrap" Text="TextBlock"/>
                    <TextBlock x:Name="AmountTextBlock" TextWrapping="Wrap" Text="TextBlock"/>
                </StackPanel>
            </Border>
            <Border BorderBrush="Black" BorderThickness="2" Margin="800,10,10,10">
                <TextBlock x:Name="DiscountTextBlock" TextWrapping="Wrap" Text="TextBlock" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

        </Grid>
    </Border>

</UserControl>
