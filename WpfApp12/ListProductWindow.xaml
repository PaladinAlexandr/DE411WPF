<Window x:Class="WpfApp12.ListProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp12"
        mc:Ignorable="d"
        Icon="/Resources/Icon.png"
        Title="ListProductWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="26*"/>
            <RowDefinition Height="61*"/>
        </Grid.RowDefinitions>
        <ListBox x:Name="ProductListBox" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="0,5,0,0" Grid.Row="1" Grid.ColumnSpan="2"/>
        <TextBlock x:Name="FullNameTextBlock" HorizontalAlignment="Right" Margin="0,10,10,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" Height="22" Width="192" TextAlignment="Right" Grid.ColumnSpan="2"/>
        <StackPanel Height="25" x:Name="AdminPanel"  Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,25,0,0">
            <Button Content="Добавить товар" Width="137"/>
            <Button Content="Редактировать товар" Width="137"/>
            <Button Content="Удалить товар" Width="137"/>
        </StackPanel>
        <StackPanel  Height="25" x:Name="ManagerPanel" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Grid.ColumnSpan="2">
            <TextBox x:Name="SearchTextBox" Foreground="White" Background="SeaGreen" TextWrapping="Wrap"  Width="453" TextChanged="SearchTextBox_TextChanged"/>
            <ComboBox Name="OrderProductCombobox"  Width="120" SelectionChanged="OrderProductCombobox_SelectionChanged">
                <ComboBoxItem>По возрастнию</ComboBoxItem>
                <ComboBoxItem>По убыванию</ComboBoxItem>
            </ComboBox>
            <ComboBox Name="FilterSupplierCombobox" Width="120" SelectionChanged="FilterSupplierCombobox_SelectionChanged">
                <ComboBoxItem>Все поставщики</ComboBoxItem>
                <ComboBoxItem>Kari</ComboBoxItem>
                <ComboBoxItem>Обувь для вас</ComboBoxItem>
            </ComboBox>
        </StackPanel>

    </Grid>
</Window>
